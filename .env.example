# Скопируйте в .env и задайте свои значения: cp .env.example .env
# Файл .env в git не коммитится (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me-please

# --- Приложение ---
APP_PORT=8000
LOG_LEVEL=INFO

# Пауза после SIGTERM перед закрытием пула — чтобы наглядно увидеть graceful shutdown.
SHUTDOWN_DELAY_SECONDS=3
